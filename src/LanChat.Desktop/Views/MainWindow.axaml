<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:icons="using:LanChat.Desktop.Controls"
        xmlns:vm="using:LanChat.Desktop.ViewModels" xmlns:views="using:LanChat.Desktop.Views"
        x:Class="LanChat.Desktop.Views.MainWindow" x:DataType="vm:MainWindowViewModel"
        Title="{DynamicResource Loc.FeilvLANFileTransfer}" Width="420" Height="760" MinWidth="360" MinHeight="540"
        WindowStartupLocation="CenterScreen" SystemDecorations="None" Background="Transparent" TransparencyLevelHint="Transparent">
  <Window.Styles>
    <Style Selector="Border.windowFrame"><Setter Property="Margin" Value="16" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="16" /><Setter Property="BoxShadow" Value="{DynamicResource WindowShadow}" /></Style>
    <Style Selector="Border.windowSurface"><Setter Property="CornerRadius" Value="15" /><Setter Property="ClipToBounds" Value="True" /></Style>
    <Style Selector="Border.windowFrame.expanded"><Setter Property="Margin" Value="0" /><Setter Property="BorderThickness" Value="0" /><Setter Property="CornerRadius" Value="0" /><Setter Property="BoxShadow" Value="none" /></Style>
    <Style Selector="Border.windowSurface.expanded"><Setter Property="CornerRadius" Value="0" /></Style>
  </Window.Styles>
  <Border x:Name="WindowFrame" Classes="windowFrame" BorderBrush="{DynamicResource WindowBorderBrush}" Background="{DynamicResource PanelBrush}">
    <Border x:Name="WindowSurface" Classes="windowSurface">
      <Grid RowDefinitions="44,*,Auto">
        <Grid Background="{DynamicResource RailBrush}" ColumnDefinitions="*,Auto" PointerPressed="TitleBarPointerPressed">
          <Grid ColumnDefinitions="Auto,Auto,*" Margin="12,0,8,0" VerticalAlignment="Center">
            <Button x:Name="BackToFilesButton" IsVisible="{Binding !IsFiles}" Classes="icon" Command="{Binding NavigateCommand}" CommandParameter="Files" Padding="4" MinWidth="26" MinHeight="28" Margin="0,0,8,0" ToolTip.Tip="{DynamicResource Loc.BackToTransfers}"><icons:SvgIcon Kind="arrow-up" Width="16" Height="16" RenderTransform="rotate(-90deg)" /></Button>
            <icons:BrandLogo Grid.Column="1" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBlock x:Name="PageHeading" Grid.Column="2" Text="{Binding PageTitle, Converter={StaticResource Translate}}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding PageTitle, Converter={StaticResource Translate}}" />
          </Grid>
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button x:Name="OpenDownloadsButton" Classes="window" Width="30" Height="44" Command="{Binding Settings.OpenDownloadsCommand}" ToolTip.Tip="{DynamicResource Loc.OpenDownloadsFolder}" AutomationProperties.Name="{DynamicResource Loc.OpenDownloadsFolder}"><icons:SvgIcon Kind="folder" Width="15" Height="15" /></Button>
            <Button x:Name="QrShareButton" Classes="window" Width="30" Height="44" Command="{Binding OpenQrShareCommand}" IsEnabled="{Binding !Inbox.IsPickerOpen}" ToolTip.Tip="{DynamicResource Loc.QRSharing}" AutomationProperties.Name="{DynamicResource Loc.QRSharing}"><icons:SvgIcon Kind="qr-code" Width="15" Height="15" /></Button>
            <Button x:Name="ThemeToggleButton" Classes="window" Width="30" Height="44" Command="{Binding Settings.SetThemeCommand}" CommandParameter="{DynamicResource ThemeToggleTarget}" ToolTip.Tip="{DynamicResource Loc.ToggleLightDarkTheme}" AutomationProperties.Name="{DynamicResource Loc.ToggleLightDarkTheme}">
              <icons:SvgIcon x:Name="ThemeToggleIcon" Kind="{DynamicResource ThemeToggleIcon}" Width="15" Height="15" />
            </Button>
            <Button x:Name="MainMenuButton" Classes="window" Width="30" Height="44" IsEnabled="{Binding !Inbox.IsPickerOpen}" ToolTip.Tip="{DynamicResource Loc.TransfersSharingAndSettings}" AutomationProperties.Name="{DynamicResource Loc.MoreOptions}">
              <icons:SvgIcon Kind="settings" Width="15" Height="15" />
              <Button.Flyout><MenuFlyout>
                <MenuItem Header="{DynamicResource Loc.Transfers}" Command="{Binding NavigateCommand}" CommandParameter="Files" />
                <MenuItem Header="{DynamicResource Loc.SharedFolders}" Command="{Binding NavigateCommand}" CommandParameter="Shares" />
                <MenuItem Header="{DynamicResource Loc.Settings}" Command="{Binding NavigateCommand}" CommandParameter="Settings" />
              </MenuFlyout></Button.Flyout>
            </Button>
            <Button Classes="window" Width="38" Height="44" Click="MinimizeClicked" ToolTip.Tip="{DynamicResource Loc.MinimizeToTray}"><icons:SvgIcon Kind="minus" Width="14" Height="14" /></Button>
            <Button Classes="window" Width="38" Height="44" Click="CloseClicked" ToolTip.Tip="{DynamicResource Loc.HideToTray}"><icons:SvgIcon Kind="x" Width="15" Height="15" /></Button>
          </StackPanel>
        </Grid>
        <Grid Grid.Row="1" IsVisible="{Binding IsFiles}"><views:FileInboxView DataContext="{Binding Inbox}" /></Grid>
        <Grid Grid.Row="1" IsVisible="{Binding IsShares}"><views:SharesView DataContext="{Binding Shares}" /></Grid>
        <Grid Grid.Row="1" IsVisible="{Binding IsSettings}"><views:SettingsView DataContext="{Binding Settings}" /></Grid>
        <Grid Grid.Row="1" IsVisible="{Binding IsQr}"><views:QrShareView DataContext="{Binding QrShare}" /></Grid>
        <Border Grid.Row="2" IsVisible="{Binding ShowPageStatus}" Background="{DynamicResource RailBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,9">
          <TextBlock Text="{Binding Status, Converter={StaticResource Translate}}" ToolTip.Tip="{Binding Status, Converter={StaticResource Translate}}" Classes="muted" FontSize="11" TextWrapping="Wrap" MaxHeight="48" TextTrimming="CharacterEllipsis" />
        </Border>
      </Grid>
    </Border>
  </Border>
</Window>
