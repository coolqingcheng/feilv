<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LanChat.Desktop.ViewModels" x:Class="LanChat.Desktop.Views.SettingsView" x:DataType="vm:SettingsViewModel">
  <ScrollViewer x:Name="SettingsScroll" Background="{DynamicResource CanvasBrush}" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="14,18" Spacing="16" MaxWidth="560" HorizontalAlignment="Stretch">
      <Border Classes="card" Padding="16"><StackPanel Spacing="16">
        <Grid ColumnDefinitions="76,*">
          <Grid Width="60" Height="60" HorizontalAlignment="Left"><Border CornerRadius="30" Background="{DynamicResource SelectedBrush}"><TextBlock Text="{Binding Initial}" FontSize="25" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><Border CornerRadius="30" ClipToBounds="True"><Image Source="{Binding Avatar}" Stretch="UniformToFill" /></Border></Grid>
          <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center"><TextBlock Text="设备头像" FontWeight="SemiBold" /><Button Content="更换头像" Command="{Binding ChangeAvatarCommand}" FontSize="12" Padding="10,5" HorizontalAlignment="Left" /></StackPanel>
        </Grid>
        <StackPanel Spacing="8"><TextBlock Text="设备名称" Classes="section" /><TextBox Text="{Binding Nickname}" MaxLength="40" Watermark="发送文件时显示给对方" /></StackPanel>
        <CheckBox IsChecked="{Binding ShowNotifications}"><TextBlock Text="后台收到文件时显示接收提示" TextWrapping="Wrap" /></CheckBox>
        <CheckBox x:Name="StartWithWindowsOption" IsChecked="{Binding StartWithWindows}"><TextBlock Text="开机启动飞驴" TextWrapping="Wrap" /></CheckBox>
        <Button Classes="primary" Content="保存设置" Command="{Binding SaveCommand}" HorizontalAlignment="Stretch" />
      </StackPanel></Border>
      <Border Classes="card" Padding="16"><StackPanel Spacing="12">
        <TextBlock Text="外观主题" FontSize="15" FontWeight="SemiBold" />
        <Grid ColumnDefinitions="*,*,*"><Button Content="跟随系统" Command="{Binding SetThemeCommand}" CommandParameter="System" HorizontalAlignment="Stretch" Padding="6,10" Margin="0,0,4,0" /><Button Grid.Column="1" Content="Dark" Command="{Binding SetThemeCommand}" CommandParameter="Dark" HorizontalAlignment="Stretch" Padding="6,10" Margin="2,0" /><Button Grid.Column="2" Content="Light" Command="{Binding SetThemeCommand}" CommandParameter="Light" HorizontalAlignment="Stretch" Padding="6,10" Margin="4,0,0,0" /></Grid>
        <TextBlock Text="{Binding ThemeDescription}" Classes="muted" FontSize="11" />
      </StackPanel></Border>
      <Border Classes="card" Padding="16"><StackPanel Spacing="12">
        <TextBlock Text="局域网连接" FontSize="15" FontWeight="SemiBold" />
        <TextBlock Text="设备会自动发现。未发现对方时，可通过 IP 手动连接。" Classes="muted" TextWrapping="Wrap" FontSize="12" />
        <TextBlock Text="本机地址" Classes="section" /><SelectableTextBlock Text="{Binding LocalEndpoint}" FontSize="12" TextWrapping="Wrap" />
        <TextBox x:Name="ManualAddressBox" Text="{Binding ManualAddress}" Watermark="对方 IP，如 192.168.1.8" AutomationProperties.Name="对方 IP 地址" />
        <Grid ColumnDefinitions="*,Auto"><TextBox Text="{Binding ManualPort}" Watermark="端口" AutomationProperties.Name="对方端口" /><Button Grid.Column="1" Content="连接" Command="{Binding ConnectCommand}" IsEnabled="{Binding !IsConnecting}" Margin="8,0,0,0" Padding="16,8" /></Grid>
      </StackPanel></Border>
      <Border Classes="card" Padding="16"><StackPanel Spacing="12">
        <TextBlock Text="文件与存储" FontSize="15" FontWeight="SemiBold" /><TextBlock Text="接收文件按日期保存" Classes="section" />
        <TextBlock Text="{Binding DownloadDirectory}" TextWrapping="Wrap" Classes="muted" FontSize="12" />
        <Button Content="打开接收目录" Command="{Binding OpenDownloadsCommand}" HorizontalAlignment="Stretch" />
        <TextBlock Text="设备标识" Classes="section" /><TextBlock Text="{Binding DeviceId}" FontSize="12" Classes="muted" />
      </StackPanel></Border>
      <StackPanel Margin="0,0,0,10" Spacing="6"><TextBlock Text="{Binding VersionLabel}" Classes="muted" TextAlignment="Center" FontSize="11" /><TextBlock Text="局域网内，轻松传文件。" Classes="muted" TextAlignment="Center" FontSize="11" /></StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
