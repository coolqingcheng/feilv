<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LanChat.Desktop.ViewModels" x:Class="LanChat.Desktop.Views.UpdateReadyWindow" x:DataType="vm:AppUpdatesViewModel"
        Width="388" Height="400" CanResize="False" SystemDecorations="None" Background="Transparent"
        TransparencyLevelHint="Transparent" ShowInTaskbar="False" ShowActivated="False" Topmost="True" Title="{DynamicResource Loc.FeilvUpdateReady}">
  <Border Margin="16" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource WindowBorderBrush}"
          BorderThickness="1" CornerRadius="14" BoxShadow="{DynamicResource WindowShadow}" Padding="18">
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" RowSpacing="12">
      <TextBlock Text="{DynamicResource Loc.UpdateReady}" FontSize="15" FontWeight="SemiBold" />
      <StackPanel Grid.Row="1" Spacing="8">
        <TextBlock Text="{Binding ReadyMessage, Converter={StaticResource Translate}}" TextWrapping="Wrap" FontSize="12" IsVisible="{Binding !IsInstalling}" />
        <TextBlock Text="{Binding Status, Converter={StaticResource Translate}}" TextWrapping="Wrap" FontSize="12" IsVisible="{Binding IsInstalling}" />
        <ProgressBar IsIndeterminate="True" Height="4" IsVisible="{Binding IsInstalling}" />
      </StackPanel>
      <TextBlock Grid.Row="2" Text="{Binding ReleaseNotesTitle, Converter={StaticResource Translate}}" FontWeight="SemiBold" FontSize="12" />
      <ScrollViewer x:Name="ReleaseNotesScroll" Grid.Row="3" HorizontalScrollBarVisibility="Disabled">
        <TextBlock x:Name="UpdateReleaseNotes" Text="{Binding ReleaseNotesText}" Classes="muted" TextWrapping="Wrap" FontSize="12" />
      </ScrollViewer>
      <TextBlock Grid.Row="4" Text="{DynamicResource Loc.FeilvWillCloseAndRestartYourLocalDataWillBeKept}" Classes="muted" TextWrapping="Wrap" FontSize="11" />
      <Grid Grid.Row="5" ColumnDefinitions="*,*">
        <Button Content="{DynamicResource Loc.Later}" Click="LaterClicked" HorizontalAlignment="Stretch" Margin="0,0,5,0" />
        <Button Grid.Column="1" Content="{DynamicResource Loc.UpdateNow}" Command="{Binding InstallCommand}" Classes="primary" HorizontalAlignment="Stretch" Margin="5,0,0,0" />
      </Grid>
    </Grid>
  </Border>
</Window>
