<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:icons="using:LanChat.Desktop.Controls"
             xmlns:vm="using:LanChat.Desktop.ViewModels" xmlns:models="using:LanChat.Core.Models"
             x:Class="LanChat.Desktop.Views.SharesView" x:DataType="vm:SharesViewModel">
  <ScrollViewer x:Name="SharesScroll" Background="{DynamicResource CanvasBrush}" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="14,18" Spacing="16" MaxWidth="560" HorizontalAlignment="Stretch">
      <Border Classes="card" Padding="16"><StackPanel Spacing="14">
        <TextBlock Text="{DynamicResource Loc.MySharedFolders}" FontSize="15" FontWeight="SemiBold" />
        <TextBlock Text="{DynamicResource Loc.OtherComputersOnYourLANCanBrowseAndDownloadTheseFiles}" TextWrapping="Wrap" FontSize="12" Classes="muted" />
        <Button Command="{Binding AddFolderCommand}" HorizontalAlignment="Stretch"><StackPanel Orientation="Horizontal" Spacing="7"><icons:SvgIcon Kind="plus" Width="16" Height="16" /><TextBlock Text="{DynamicResource Loc.AddFolder}" /></StackPanel></Button>
        <ItemsControl ItemsSource="{Binding LocalFolders}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="models:SharedFolder">
          <StackPanel Spacing="8" Margin="0,8"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{Binding LocalPath}" TextWrapping="Wrap" Classes="muted" FontSize="11" /><Button Content="{DynamicResource Loc.StopSharing}" HorizontalAlignment="Left" FontSize="12" Command="{Binding $parent[UserControl].((vm:SharesViewModel)DataContext).RemoveFolderCommand}" CommandParameter="{Binding}" /></StackPanel>
        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </StackPanel></Border>
      <Border Classes="card" Padding="16"><StackPanel Spacing="14">
        <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{DynamicResource Loc.BrowseOtherComputers}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" /><Button Grid.Column="1" Content="{DynamicResource Loc.Refresh}" Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsBusy}" FontSize="12" Padding="10,6" /></Grid>
        <ComboBox x:Name="ShareDevicePicker" ItemsSource="{Binding Devices}" SelectedItem="{Binding Peer}" PlaceholderText="{DynamicResource Loc.ChooseAnOnlineComputer}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{DynamicResource Loc.SharingComputer}">
          <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:PeerViewModel"><StackPanel Spacing="3"><TextBlock Text="{Binding Nickname}" TextWrapping="Wrap" /><TextBlock Text="{Binding Address, Converter={StaticResource Translate}}" Classes="muted" FontSize="11" /></StackPanel></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock IsVisible="{Binding !HasPeer}" Text="{DynamicResource Loc.ChooseAComputerToBrowseItsSharesConnectByIPInSettingsIfNeeded}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
        <StackPanel IsVisible="{Binding HasPeer}" Spacing="12">
          <Grid ColumnDefinitions="Auto,*"><Button IsEnabled="{Binding CanGoUp}" Command="{Binding GoUpCommand}" Padding="10,5"><StackPanel Orientation="Horizontal" Spacing="6"><icons:SvgIcon Kind="arrow-up" Width="14" Height="14" /><TextBlock Text="{DynamicResource Loc.Back}" /></StackPanel></Button><TextBlock Grid.Column="1" Text="{Binding LocationLabel}" TextTrimming="CharacterEllipsis" Margin="10,0,0,0" Classes="muted" VerticalAlignment="Center" FontSize="12" /></Grid>
          <ProgressBar IsVisible="{Binding IsBusy}" IsIndeterminate="True" Height="3" />
          <TextBlock IsVisible="{Binding IsEmpty}" Text="{DynamicResource Loc.NoSharedFilesTryRefreshing}" TextWrapping="Wrap" Classes="muted" FontSize="12" />
          <ItemsControl ItemsSource="{Binding RemoteEntries}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:SharedEntryViewModel">
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,10"><Grid ColumnDefinitions="24,*,Auto"><icons:SvgIcon Kind="{Binding Icon}" Width="20" Height="20" Foreground="{DynamicResource AccentBrush}" /><StackPanel Grid.Column="1" Spacing="5" Margin="8,0"><TextBlock Text="{Binding Name}" TextWrapping="Wrap" /><TextBlock Text="{Binding Description, Converter={StaticResource Translate}}" FontSize="11" Classes="muted" /></StackPanel><Button Grid.Column="2" Content="{Binding Action, Converter={StaticResource Translate}}" FontSize="12" Padding="8,6" Command="{Binding $parent[UserControl].((vm:SharesViewModel)DataContext).OpenEntryCommand}" CommandParameter="{Binding}" /></Grid></Border>
          </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </StackPanel>
      </StackPanel></Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
