<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:icons="using:LanChat.Desktop.Controls"
             x:Class="LanChat.Desktop.App" RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="RailBrush">#252526</SolidColorBrush>
          <SolidColorBrush x:Key="PanelBrush">#1E1E1F</SolidColorBrush>
          <SolidColorBrush x:Key="CanvasBrush">#252526</SolidColorBrush>
          <SolidColorBrush x:Key="CardBrush">#2F2F30</SolidColorBrush>
          <SolidColorBrush x:Key="DeviceListBrush">#2F2F30</SolidColorBrush>
          <SolidColorBrush x:Key="BorderBrush">#3B3B3D</SolidColorBrush>
          <SolidColorBrush x:Key="WindowBorderBrush">#4A4A4D</SolidColorBrush>
          <BoxShadows x:Key="WindowShadow">0 5 16 0 #60000000, 0 1 3 0 #40000000</BoxShadows>
          <SolidColorBrush x:Key="TextBrush">#E1E1E5</SolidColorBrush>
          <SolidColorBrush x:Key="MutedBrush">#ACACB3</SolidColorBrush>
          <SolidColorBrush x:Key="SelectedBrush">#294739</SolidColorBrush>
          <SolidColorBrush x:Key="AccentBrush">#18C77C</SolidColorBrush>
          <SolidColorBrush x:Key="PrimaryActionBrush">#07864F</SolidColorBrush>
          <SolidColorBrush x:Key="DeviceSelectedBrush">#07864F</SolidColorBrush>
          <SolidColorBrush x:Key="TabTrackBrush">#252526</SolidColorBrush>
          <SolidColorBrush x:Key="TabActiveBrush">#3B3B3D</SolidColorBrush>
          <SolidColorBrush x:Key="TabHoverBrush">#303032</SolidColorBrush>
          <SolidColorBrush x:Key="TabTextBrush">#B9B9BE</SolidColorBrush>
          <SolidColorBrush x:Key="TabActiveBorderBrush">#545458</SolidColorBrush>
          <BoxShadows x:Key="TabPillShadow">0 1 3 0 #22000000</BoxShadows>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="RailBrush">#E0E0E0</SolidColorBrush>
          <SolidColorBrush x:Key="PanelBrush">#FAFAFA</SolidColorBrush>
          <SolidColorBrush x:Key="CanvasBrush">#EEEEF0</SolidColorBrush>
          <SolidColorBrush x:Key="CardBrush">#EEEEF0</SolidColorBrush>
          <SolidColorBrush x:Key="DeviceListBrush">#EEEEF0</SolidColorBrush>
          <SolidColorBrush x:Key="BorderBrush">#E2E2E5</SolidColorBrush>
          <SolidColorBrush x:Key="WindowBorderBrush">#CECED2</SolidColorBrush>
          <BoxShadows x:Key="WindowShadow">0 5 16 0 #240F2438, 0 1 3 0 #180F2438</BoxShadows>
          <SolidColorBrush x:Key="TextBrush">#19191A</SolidColorBrush>
          <SolidColorBrush x:Key="MutedBrush">#6B6B72</SolidColorBrush>
          <SolidColorBrush x:Key="SelectedBrush">#E2F3E8</SolidColorBrush>
          <SolidColorBrush x:Key="AccentBrush">#07864F</SolidColorBrush>
          <SolidColorBrush x:Key="PrimaryActionBrush">#07864F</SolidColorBrush>
          <SolidColorBrush x:Key="DeviceSelectedBrush">#07864F</SolidColorBrush>
          <SolidColorBrush x:Key="TabTrackBrush">#E6E6E8</SolidColorBrush>
          <SolidColorBrush x:Key="TabActiveBrush">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="TabHoverBrush">#DCDCDD</SolidColorBrush>
          <SolidColorBrush x:Key="TabTextBrush">#5C5C62</SolidColorBrush>
          <SolidColorBrush x:Key="TabActiveBorderBrush">#D2D2D6</SolidColorBrush>
          <BoxShadows x:Key="TabPillShadow">0 1 4 0 #150F2438</BoxShadows>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <SolidColorBrush x:Key="OnlineBrush">#07C160</SolidColorBrush>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Dark" Accent="#18C77C" />
        <ColorPaletteResources x:Key="Light" Accent="#07864F" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <Style Selector="Window">
      <Setter Property="UseLayoutRounding" Value="True" />
      <Setter Property="FontFamily" Value="Inter, Microsoft YaHei UI, Segoe UI" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    </Style>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /></Style>
    <Style Selector="TextBlock.title"><Setter Property="FontSize" Value="21" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style Selector="TextBlock.section"><Setter Property="FontSize" Value="12" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /></Style>
    <Style Selector="Button"><Setter Property="Cursor" Value="Hand" /><Setter Property="CornerRadius" Value="10" /><Setter Property="Background" Value="{DynamicResource SelectedBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
    <Style Selector="icons|SvgIcon"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /><Setter Property="Width" Value="20" /><Setter Property="Height" Value="20" /><Setter Property="HorizontalAlignment" Value="Center" /><Setter Property="VerticalAlignment" Value="Center" /></Style>
    <Style Selector="Button.icon"><Setter Property="Background" Value="Transparent" /><Setter Property="Padding" Value="10" /><Setter Property="MinWidth" Value="36" /><Setter Property="MinHeight" Value="36" /></Style>
    <Style Selector="Button.primary"><Setter Property="Background" Value="{DynamicResource PrimaryActionBrush}" /><Setter Property="Foreground" Value="White" /><Setter Property="Padding" Value="20,11" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter, Button.primary:pressed /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource PrimaryActionBrush}" /><Setter Property="Foreground" Value="White" /></Style>
    <Style Selector="Button.nav"><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /><Setter Property="Width" Value="54" /><Setter Property="Height" Value="64" /><Setter Property="Padding" Value="8,10" /><Setter Property="HorizontalAlignment" Value="Center" /><Setter Property="CornerRadius" Value="10" /></Style>
    <Style Selector="Button.nav">
      <Setter Property="FocusAdorner"><Template><Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="10" IsHitTestVisible="False" /></Template></Setter>
    </Style>
    <Style Selector="Button.nav icons|SvgIcon"><Setter Property="Width" Value="22" /><Setter Property="Height" Value="22" /></Style>
    <Style Selector="Button.nav TextBlock"><Setter Property="FontSize" Value="10" /><Setter Property="LineHeight" Value="14" /></Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource CardBrush}" /></Style>
    <Style Selector="Button.nav.selected"><Setter Property="Background" Value="{DynamicResource SelectedBrush}" /><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /></Style>
    <Style Selector="Button.nav.selected /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource SelectedBrush}" /><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /></Style>
    <Style Selector="Button.nav.selected:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource SelectedBrush}" /><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /></Style>
    <Style Selector="Button.nav:pressed /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource SelectedBrush}" /><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /></Style>
    <Style Selector="Button.nav.selected icons|SvgIcon"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /></Style>
    <Style Selector="Button.window"><Setter Property="Background" Value="Transparent" /><Setter Property="Padding" Value="0" /><Setter Property="Width" Value="44" /><Setter Property="Height" Value="34" /><Setter Property="CornerRadius" Value="0" /></Style>
    <Style Selector="TextBox">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Background" Value="{DynamicResource CardBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="SelectionBrush" Value="{DynamicResource SelectedBrush}" />
      <Setter Property="SelectionForegroundBrush" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="TextBox:pointerover, TextBox:focus"><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /></Style>
    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{DynamicResource CardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource WindowBorderBrush}" />
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{DynamicResource CardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="TextBox /template/ TextBlock#PART_Watermark, TextBox:pointerover /template/ TextBlock#PART_Watermark, TextBox:focus /template/ TextBlock#PART_Watermark">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    </Style>
    <Style Selector="ListBoxItem"><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,2" /><Setter Property="CornerRadius" Value="12" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource SelectedBrush}" /></Style>
    <Style Selector="Border.card"><Setter Property="Background" Value="{DynamicResource CardBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="16" /><Setter Property="Padding" Value="20" /></Style>
  </Application.Styles>
</Application>
